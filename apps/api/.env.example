# --- NovaTech Hub API environment -------------------------------------------
# Copy this file to `apps/api/.env` and fill in values. Dev defaults are
# provided and work out of the box with the embedded-Postgres workflow.

# Postgres connection.
# With the embedded Postgres default (scripts/pg.ts), this is:
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/novatech_hub
# Set to a different host/port if you run Postgres yourself or via Docker.

# Embedded Postgres (used when EMBEDDED_PG=true and nothing listens on EMBED_PG_PORT).
EMBEDDED_PG=true
EMBED_PG_DATADIR=.local/pgdata
EMBED_PG_PORT=5433
EMBED_PG_USER=postgres
EMBED_PG_PASSWORD=postgres
EMBED_PG_DBNAME=novatech_hub

# JWT secrets — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Token lifetimes.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Web app origin for CORS + cookies (credentials are sent cross-origin in dev).
WEB_ORIGIN=http://localhost:5173

# The API's own public base (used to build absolute avatar/product URLs if needed).
API_BASE_URL=http://localhost:4000

# HTTP port.
PORT=4000

# Comma-separated list of common tools used by socket.io / connect.
# For production set COOKIE_SECURE=true (requires https).
COOKIE_SECURE=false