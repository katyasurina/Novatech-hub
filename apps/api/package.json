{
  "name": "@novatech/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "prisma generate && tsup src/index.ts --format esm --platform node --target node20 --out-dir dist --clean --sourcemap --no-external @novatech/shared",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pg:start": "tsx scripts/pg.ts start",
    "pg:stop": "tsx scripts/pg.ts stop",
    "pg:status": "tsx scripts/pg.ts status",
    "pg:kill": "tsx scripts/pg.ts kill",
    "db:migrate": "tsx scripts/pg.ts ensure && prisma migrate dev --name init",
    "db:migrate:prod": "prisma migrate deploy",
    "db:reset": "tsx scripts/pg.ts ensure && prisma migrate reset --force",
    "db:setup": "tsx scripts/pg.ts ensure && prisma migrate dev --name init && prisma db seed && npm run pg:status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@novatech/shared": "*",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "embedded-postgres": "18.4.0-beta.17",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}